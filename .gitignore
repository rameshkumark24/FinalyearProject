# Outputs & Temp
logs/
scratch/
temp/

# Hand-added datasets (echo images carry patient identifiers) - never commit
fetaldata/
# Downloaded model weights and caches
models_cache/
# Large intermediate arrays produced by runs (summaries and per-subject CSV/JSON stay in git)
runs/**/*.npy
runs/**/*.npz
runs/**/*.pkl
# Test and tool caches
.pytest_cache/
# Paper draft: kept private until submission (a plagiarism check must not match the paper against its own draft)
paper/
# Local record of earlier work (first build, audit plan, old Notion export); kept on disk, not in the repository
archive/
# One-patient research tool: patient files and results never enter git (scripts/predict_patient.py
# refuses to write a result anywhere else inside the repository). The small expert artifacts in
# artifacts/ are committed; any large file placed there is not.
patients/
tool_results/
artifacts/**/*.npz
artifacts/**/*.pt
artifacts/**/*.jpg
artifacts/**/*.png
artifacts/**/*.bmp
